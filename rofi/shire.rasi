/* ~/.config/rofi/shire.rasi — layout & styling.
   current.rasi (colors) is regenerated by hypr/scripts/workspace-theme.sh
   whenever you travel to another workspace. */
@import "~/.config/rofi/current.rasi"

* {
    font:             "IosevkaTermSlab Nerd Font 13";
    background-color: transparent;
    text-color:       @parchment;
}

window {
    width:            560px;
    location:         center;
    background-color: @forest;
    border:           3px;
    border-color:     @hearth;
    border-radius:    14px;
    padding:          18px;
}

mainbox { spacing: 14px; children: [ inputbar, listview ]; }

inputbar {
    background-color: @moss;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}
prompt { text-color: @hearth; }
entry {
    placeholder:       "Speak, friend, and enter…";
    placeholder-color: @stone;
    cursor:            text;
}

listview {
    lines:        7;
    columns:      1;
    spacing:      4px;
    fixed-height: true;
    scrollbar:    false;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       12px;
}
element-icon { size: 24px; }
element-text { vertical-align: 0.5; }

element normal.normal,
element alternate.normal { background-color: transparent; text-color: @parchment; }

element selected.normal {
    background-color: @hills;
    text-color:       @forest;
}
element-text selected { text-color: inherit; }

element normal.urgent, element alternate.urgent { text-color: @leaf; }
element normal.active, element alternate.active { text-color: @ring; }

message  { background-color: @moss; border-radius: 8px; padding: 8px; }
textbox  { text-color: @parchment; }
