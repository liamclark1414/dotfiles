// ~/.config/fastfetch/config.jsonc — Middle-earth welcome screen
// Colours are terminal palette names, so they follow each place's kitty theme.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "white", "2": "bright_yellow", "3": "bright_white" },
        "padding": { "top": 0, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "green", "title": "yellow" },
        "key": { "width": 12 }
    },
    "modules": [
        "break",
        // first name = username up to the first "-", capitalised (liam-clark -> Liam)
        { "type": "command", "key": " ", "keyWidth": 1, "shell": "/bin/bash",
          "text": "u=$(id -un); n=${u%%-*}; printf '\\e[1;33m%s\\e[0m, of the \\e[1;33m%s\\e[0m hearth' \"${n^}\" \"$(hostname)\"",
          "format": "{result}" },
        { "type": "custom",   "format": "\u001b[90m─────────────────────────────" },
        { "type": "os",       "key": "Realm" },
        { "type": "kernel",   "key": "Lineage" },
        { "type": "uptime",   "key": "Journey" },
        { "type": "packages", "key": "Provisions" },
        { "type": "wm",       "key": "Steward" },
        { "type": "terminal", "key": "Hearth" },
        { "type": "shell",    "key": "Tongue" },
        { "type": "cpu",      "key": "Forge" },
        { "type": "memory",   "key": "Pantry" },
        { "type": "disk",     "key": "Vaults", "folders": "/" },
        "break",
        { "type": "colors",   "symbol": "circle" }
    ]
}
